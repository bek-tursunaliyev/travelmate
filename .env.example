# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# AI chatbot (/api/chat). Server-only — never prefix these with VITE_.
# Google Gemini (https://aistudio.google.com/apikey). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Alternative when GEMINI_API_KEY is empty: Vercel AI Gateway (uses the project's OIDC token on Vercel).
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
