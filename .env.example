# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# AI chatbot (/api/chat). Server-only — never prefix these with VITE_.
# Google Gemini (https://aistudio.google.com/apikey). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Alternative when GEMINI_API_KEY is empty: Vercel AI Gateway (uses the project's OIDC token on Vercel).
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5

# Admin panel (/admin). Sign in on /login with these; any other login opens a traveller account.
# ADMIN_SECRET signs admin sessions — use a long random string.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Content storage: set automatically on Vercel when the Blob store is connected.
# Leave empty locally — `npm run dev` then saves admin edits to .content.local.json.
BLOB_READ_WRITE_TOKEN=

# iTicket.uz partner API (no public API exists; fill in once iTicket grants access).
ITICKET_API_URL=
ITICKET_API_KEY=
